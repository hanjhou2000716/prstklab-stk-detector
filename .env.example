# Copy this file to .env for a real local Telegram test. Do not commit .env.
TELEGRAM_BOT_TOKEN=
# Preferred: comma-separated private-chat IDs for all recipients.
TELEGRAM_CHAT_IDS=
# Optional bounded second retry round for recipients with temporary failures.
# Allowed range: 0..3 (default: 1).
TELEGRAM_FAILED_RECIPIENT_RETRIES=1

# Optional Phase 2 public-data keys. Keep these in GitHub Secrets/Railway Variables.
FRED_API_KEY=
EIA_API_KEY=

# The GitHub Pages URL used by the Telegram button after deployment.
DASHBOARD_URL=https://YOUR_GITHUB_USERNAME.github.io/prstklab-stk-detector/
