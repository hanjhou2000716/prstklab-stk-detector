# Copy this file to .env for a real local Telegram test. Do not commit .env.
TELEGRAM_BOT_TOKEN=
# Preferred: comma-separated private-chat IDs for all recipients.
TELEGRAM_CHAT_IDS=
# Optional bounded second retry round for recipients with temporary failures.
# Allowed range: 0..3 (default: 1).
TELEGRAM_FAILED_RECIPIENT_RETRIES=1

# Optional public-data keys. Keep these in GitHub Secrets or local environment.
FRED_API_KEY=
EIA_API_KEY=

# Zero-cost async report path (Supabase values belong only to Worker/Actions).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=hanjhou2000716/prstklab-stk-detector
TG_ALLOWED_USERS=
TG_SUBSCRIBERS=
ALLOWED_ORIGINS=
PUBLIC_API_BASE_URL=

# The GitHub Pages URL used by the Telegram button after deployment.
DASHBOARD_URL=https://YOUR_GITHUB_USERNAME.github.io/prstklab-stk-detector/
# Optional explicit market snapshot endpoint used to confirm event impact.
# If omitted, the legacy monitor requests ${DASHBOARD_URL}/data/market.json.
MARKET_SNAPSHOT_URL=
