{
  "version": "2026-07-29",
  "mode": "public-read-only",
  "polling": {
    "intervalMinutes": 5,
    "firstRunBaselineOnly": true,
    "officialEventMaxAgeMinutes": 90,
    "discoveryEventMaxAgeMinutes": 45,
    "topicCooldownMinutes": 120,
    "singleSourceFailureIsolation": true,
    "retryOn429": false
  },
  "thresholds": {
    "goldDailyAbsoluteMovePercent": 5,
    "oilDailyAbsoluteMovePercent": 5,
    "usgsMagnitude": 6.5,
    "gdacsAlertLevel": "Red",
    "marginHighPercentile": 75,
    "marginLowPercentile": 25,
    "cryptoMacd": {"fast": 12, "slow": 26, "signal": 9, "timeframes": ["1w", "1M"]}
  },
  "contracts": {
    "eventRequiredFields": ["source_tier", "fetched_at", "published_at", "event_type", "importance", "source_url", "source_domain", "cross_checked", "data_gap"],
    "quoteRequiredFields": ["source_tier", "fetched_at", "published_at", "source_domain", "stale_used"],
    "maxEventTopics": 4
  },
  "storage": {
    "eventLedger": "railway-persistent",
    "actionsCacheRole": "short-term-backup"
  },
  "phaseTwoSources": {
    "kofia": "https://freesis.kofia.or.kr/stat/FreeSIS.do?parentDivId=MSIS10000000000000&serviceId=STATSCU0100000070",
    "fred": "https://api.stlouisfed.org/fred/series/observations",
    "eia": "https://api.eia.gov/v2/petroleum/pri/spt/data/",
    "crypto": "https://api.binance.com/api/v3/klines",
    "requiredEnvironmentVariables": ["FRED_API_KEY", "EIA_API_KEY"]
  },
  "security": {
    "noPrivateAccounts": true,
    "noTrading": true,
    "noCredentialRequests": true,
    "noHiddenOrReverseEngineeredApis": true,
    "noRateLimitBypass": true,
    "shareApiKeys": false
  },
  "requiredDisclaimer": "\u50c5\u4f9b\u516c\u958b\u8cc7\u8a0a\u6574\u7406\u8207\u6559\u80b2\u6027\u89c0\u5bdf\uff0c\u4e0d\u69cb\u6210\u6295\u8cc7\u5efa\u8b70\u3002"
}
