{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk.example/schemas/instrument-master.schema.json",
  "type": "object",
  "required": ["schema_version", "registry_id", "instruments"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "registry_id": {"type": "string", "pattern": "^instrument-[a-f0-9]{16}$"},
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instrument_id", "ticker", "name", "market", "asset_type", "currency", "timezone", "symbols", "aliases"],
        "properties": {
          "instrument_id": {"type": "string", "minLength": 1},
          "ticker": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "market": {"type": "string", "minLength": 1},
          "asset_type": {"type": "string", "minLength": 1},
          "currency": {"type": "string", "minLength": 1},
          "timezone": {"type": "string", "minLength": 1},
          "symbols": {"type": "array", "items": {"type": "string"}},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "isin": {"type": ["string", "null"]},
          "sec_cik": {"type": ["string", "null"]},
          "listed_from": {"type": ["string", "null"], "format": "date"},
          "listed_until": {"type": ["string", "null"], "format": "date"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
