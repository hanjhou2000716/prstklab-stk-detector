{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk.example/schemas/briefing-narrative.schema.json",
  "title": "Briefing narrative",
  "description": "Optional evidence-first narrative projection for a scheduled briefing section.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "slot", "section", "as_of", "focus", "highlights", "details", "evidence_refs", "limitations"],
  "properties": {
    "version": {"type": "string", "const": "four-report-narrative-v1"},
    "slot": {"type": "string", "minLength": 1},
    "section": {"type": "string", "enum": ["risk", "taiwan", "semiconductor", "external"]},
    "as_of": {},
    "focus": {"type": "string", "minLength": 1},
    "highlights": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
    "details": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text", "evidence_refs"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
