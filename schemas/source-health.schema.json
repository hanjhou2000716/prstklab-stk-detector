{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk.example/schemas/source-health.schema.json",
  "type": "object",
  "required": ["status", "sources", "event_scan"],
  "properties": {
    "checked_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["healthy", "no_event", "no_new_content", "fallback_active", "degraded_with_fallback", "secondary_unavailable", "configuration_missing", "configuration_required", "warming", "stale", "partial", "optional_degraded", "parse_failed", "provider_failed", "failed", "scan_failed", "critical", "pending", "pending_confirmation", "release_blocked"]},
    "summary": {"type": "string"},
    "investor_status": {"enum": ["資料正常", "部分資料降級", "核心資料不足"]},
    "missing_source_count": {"type": "integer", "minimum": 0},
    "runtime_failure_count": {"type": "integer", "minimum": 0},
    "configuration_missing_count": {"type": "integer", "minimum": 0},
    "data_gaps": {"type": "array"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "event_scan": {"$ref": "#/$defs/eventScan"},
    "observability": {"$ref": "#/$defs/observability"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["key", "status"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "status": {"type": "string", "minLength": 1},
        "state": {"type": "string"},
        "semantic_state": {"type": "string"},
        "role": {"type": "string"},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "last_success_at": {"type": ["string", "null"], "format": "date-time"},
        "max_consecutive_failures": {"type": "integer", "minimum": 0},
        "fallback_count": {"type": "integer", "minimum": 0},
        "error_codes": {"type": "array", "items": {"type": "string"}},
        "source_urls": {"type": "array", "items": {"type": "string"}},
        "data_gaps": {"type": "array"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "no_event": {"type": "boolean"},
        "pending_count": {"type": "integer", "minimum": 0},
        "observability": {
          "oneOf": [
            {"$ref": "#/$defs/externalObservability"},
            {"$ref": "#/$defs/creatorObservability"}
          ]
        }
      },
      "additionalProperties": true
    },
    "eventScan": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["no_event", "event_detected", "incomplete", "scan_failed"]},
        "has_events": {"type": "boolean"},
        "label": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": true
    },
    "observability": {
      "type": "object",
      "properties": {
        "observations": {"type": "integer", "minimum": 0},
        "success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "failure_count": {"type": "integer", "minimum": 0},
        "no_event_count": {"type": "integer", "minimum": 0},
        "stale_count": {"type": "integer", "minimum": 0},
        "degraded_count": {"type": "integer", "minimum": 0},
        "crosscheck_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "parser_error_count": {"type": "integer", "minimum": 0},
        "state": {"enum": ["healthy", "partial", "failed", "no_observations"]},
        "history": {"$ref": "#/$defs/history"}
      },
      "additionalProperties": true
    },
    "history": {
      "type": "object",
      "required": ["retention_hours", "max_samples", "sample_count", "windows", "samples"],
      "properties": {
        "retention_hours": {"type": "integer", "minimum": 24, "maximum": 168},
        "max_samples": {"type": "integer", "minimum": 1, "maximum": 168},
        "sample_count": {"type": "integer", "minimum": 0, "maximum": 168},
        "invalid_sample_count": {"type": "integer", "minimum": 0},
        "last_checked_at": {"type": ["string", "null"], "format": "date-time"},
        "windows": {
          "type": "object",
          "required": ["24h", "7d"],
          "properties": {
            "24h": {"$ref": "#/$defs/historyMetric"},
            "7d": {"$ref": "#/$defs/historyMetric"}
          },
          "additionalProperties": false
        },
        "samples": {"type": "array", "maxItems": 168, "items": {"$ref": "#/$defs/historySample"}}
      },
      "additionalProperties": false
    },
    "historyMetric": {
      "type": "object",
      "required": ["sample_count", "failure_count", "no_event_count", "stale_count", "parser_error_count", "state"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "failure_count": {"type": "integer", "minimum": 0},
        "no_event_count": {"type": "integer", "minimum": 0},
        "stale_count": {"type": "integer", "minimum": 0},
        "crosscheck_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "parser_error_count": {"type": "integer", "minimum": 0},
        "state": {"enum": ["healthy", "partial", "failed", "no_observations"]}
      },
      "additionalProperties": false
    },
    "historySample": {
      "type": "object",
      "required": ["checked_at", "sample_count", "failure_count", "no_event_count", "stale_count", "parser_error_count", "state"],
      "properties": {
        "checked_at": {"type": "string", "format": "date-time"},
        "sample_count": {"const": 1},
        "success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "failure_count": {"type": "integer", "minimum": 0},
        "no_event_count": {"type": "integer", "minimum": 0},
        "stale_count": {"type": "integer", "minimum": 0},
        "crosscheck_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "parser_error_count": {"type": "integer", "minimum": 0},
        "state": {"enum": ["healthy", "partial", "failed", "no_observations"]}
      },
      "additionalProperties": false
    },
    "externalObservability": {
      "type": "object",
      "properties": {
        "last_received_at": {"type": ["string", "null"], "format": "date-time"},
        "last_parsed_at": {"type": ["string", "null"], "format": "date-time"},
        "parser_error_count": {"type": "integer", "minimum": 0},
        "last_importance_ge8_at": {"type": ["string", "null"], "format": "date-time"},
        "qualifying_item_count": {"type": "integer", "minimum": 0},
        "pending_cluster_count": {"type": "integer", "minimum": 0},
        "last_notification_decision": {"enum": ["eligible", "pending_confirmation", "no_event"]},
        "last_delivery_at": {"type": ["string", "null"], "format": "date-time"},
        "last_importance_gte_8_at": {"type": ["string", "null"], "format": "date-time"},
        "decision": {"type": "string"},
        "last_release_id": {"type": ["string", "null"]},
        "last_snapshot_id": {"type": ["string", "null"]},
        "last_observation_id": {"type": ["string", "null"]},
        "last_telegram_delivery_at": {"type": ["string", "null"], "format": "date-time"},
        "last_telegram_delivery_status": {"type": "string"},
        "importance_gte_8_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "creatorObservability": {
      "type": "object",
      "properties": {
        "observations": {"type": "integer", "minimum": 0},
        "last_received_at": {"type": ["string", "null"], "format": "date-time"},
        "last_parsed_at": {"type": ["string", "null"], "format": "date-time"},
        "parser_error_count": {"type": "integer", "minimum": 0},
        "no_event_count": {"type": "integer", "minimum": 0},
        "last_delivery_at": {"type": ["string", "null"], "format": "date-time"},
        "morning_batch_count": {"type": "integer", "minimum": 0},
        "daily_coverage_count": {"type": "integer", "minimum": 0},
        "coverage_status": {"type": "string"},
        "morning_batch_state": {"type": "string"},
        "morning_batch_key": {"type": ["string", "null"]},
        "consensus_status": {"type": "string"},
        "last_release_id": {"type": ["string", "null"]},
        "last_snapshot_id": {"type": ["string", "null"]},
        "last_observation_id": {"type": ["string", "null"]},
        "last_telegram_delivery_at": {"type": ["string", "null"], "format": "date-time"},
        "last_telegram_delivery_status": {"type": "string"},
        "state": {"enum": ["healthy", "no_observations", "parse_failed", "media_degraded", "failed"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
