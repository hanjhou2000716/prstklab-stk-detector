{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk.example/schemas/news-intelligence.schema.json",
  "type": "object",
  "required": ["schema_version", "provider_registry", "stories", "interest_graph", "status"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "provider_registry": {"type": "array", "items": {"type": "object"}},
    "stories": {"type": "array", "items": {"$ref": "#/$defs/story"}},
    "interest_graph": {"type": "object"},
    "status": {"enum": ["ready", "no_event"]},
    "collection_state": {"enum": ["ready", "degraded", "no_event", "source_failed"]},
    "source_failure_count": {"type": "integer", "minimum": 0},
    "scan_summary": {
      "type": "object",
      "properties": {
        "provider_count": {"type": "integer", "minimum": 0},
        "successful_provider_count": {"type": "integer", "minimum": 0},
        "failed_provider_count": {"type": "integer", "minimum": 0},
        "disabled_provider_count": {"type": "integer", "minimum": 0},
        "fetched": {"type": "integer", "minimum": 0},
        "normalized": {"type": "integer", "minimum": 0},
        "eligible": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "deduped": {"type": "integer", "minimum": 0},
        "publicly_ranked": {"type": "integer", "minimum": 0},
        "current_eligible": {"type": "integer", "minimum": 0},
        "inventory_considered": {"type": "integer", "minimum": 0},
        "inventory_eligible": {"type": "integer", "minimum": 0},
        "inventory_selected": {"type": "integer", "minimum": 0},
        "final_public_count": {"type": "integer", "minimum": 0},
        "filtered_story_count": {"type": "integer", "minimum": 0},
        "fetched_story_count": {"type": "integer", "minimum": 0},
        "normalized_story_count": {"type": "integer", "minimum": 0},
        "eligible_story_count": {"type": "integer", "minimum": 0},
        "deduped_story_count": {"type": "integer", "minimum": 0},
        "ranked_story_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "retention_trading_sessions": {"type": "integer", "minimum": 1},
        "max_calendar_days": {"type": "integer", "minimum": 1},
        "considered": {"type": "integer", "minimum": 0},
        "eligible": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "source_health": {"type": "array", "items": {"type": "object"}},
    "observability": {
      "type": "object",
      "required": ["stories_ingested", "stories_deduped", "ranked_count", "relevance_distribution", "providers"],
      "properties": {
        "stories_ingested": {"type": "integer", "minimum": 0},
        "stories_deduped": {"type": "integer", "minimum": 0},
        "ranked_count": {"type": "integer", "minimum": 0},
        "relevance_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "status", "stories_ingested", "stories_deduped", "ranked_count", "relevance_distribution"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "last_success_at": {"type": ["string", "null"]},
              "last_failure_at": {"type": ["string", "null"]},
              "stories_ingested": {"type": "integer", "minimum": 0},
              "stories_deduped": {"type": "integer", "minimum": 0},
              "ranked_count": {"type": "integer", "minimum": 0},
              "relevance_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "source_diversity": {
      "type": "object",
      "required": ["status", "cross_checked", "independent_source_count", "minimum_required"],
      "properties": {
        "schema_version": {"type": "string"},
        "status": {"enum": ["no_event", "single_source", "multi_source"]},
        "cross_checked": {"type": "boolean"},
        "minimum_required": {"type": "integer", "minimum": 2},
        "independent_source_count": {"type": "integer", "minimum": 0},
        "provider_count": {"type": "integer", "minimum": 0},
        "provider_ids": {"type": "array", "items": {"type": "string"}},
        "source_domains": {"type": "array", "items": {"type": "string"}},
        "supporting_source_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "story": {
      "type": "object",
      "required": ["story_id", "provider", "source_tier", "authority_tier", "title", "canonical_url", "market", "dedupe_key", "public_safe"],
      "properties": {
        "story_id": {"type": "string", "minLength": 8},
        "provider": {"type": "string", "minLength": 1},
        "source_tier": {"type": "string", "minLength": 1},
        "authority_tier": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "pattern": "^https://"},
        "market": {"enum": ["taiwan", "us", "global", "cross_market"]},
        "dedupe_key": {"type": "string", "minLength": 1},
        "event_cluster_key": {"type": "string"},
        "published_time_bucket": {"type": ["string", "null"]},
        "entities": {"type": "array", "items": {"type": "string"}},
        "evidence_state": {"enum": ["official", "observation"]},
        "confirmation_required": {"type": "boolean"},
        "public_safe": {"type": "boolean"},
        "selection_lane": {"enum": ["current", "inventory"]},
        "inventory_used": {"type": "boolean"},
        "inventory_age_trading_sessions": {"type": ["integer", "null"], "minimum": 1, "maximum": 3},
        "inventory_saved_at": {"type": ["string", "null"], "format": "date-time"},
        "eligibility_ruleset": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
