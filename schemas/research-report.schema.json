{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk.example/schemas/research-report.schema.json",
  "type": "object",
  "required": ["schema_version", "sources", "candidates", "health", "generated_at"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "release_id": {"type": "string", "minLength": 8},
    "snapshot_id": {"type": "string", "minLength": 8},
    "policy_version": {"type": "string", "minLength": 1},
    "scan_mode": {"enum": ["production", "smoke", "debug"]},
    "scan_scope": {"enum": ["full", "bounded"]},
    "publication_state": {"enum": ["production", "mixed_strategy", "diagnostic", "fallback"]},
    "target_market": {"enum": ["taiwan", "us", "both"]},
    "research_slot_key": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 1},
    "source_commit_sha": {"type": ["string", "null"], "minLength": 7},
    "research_run": {
      "type": "object",
      "required": ["run_id", "run_started_at", "run_finished_at", "scan_mode", "scan_scope", "producer"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "source_commit_sha": {"type": ["string", "null"], "minLength": 7},
        "run_started_at": {"type": "string", "format": "date-time"},
        "run_finished_at": {"type": "string", "format": "date-time"},
        "scan_mode": {"enum": ["production", "smoke", "debug"]},
        "scan_scope": {"enum": ["full", "bounded"]},
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "universe_expected": {"type": "integer", "minimum": 0},
    "universe_scanned": {"type": "integer", "minimum": 0},
    "universe_completed": {"type": "integer", "minimum": 0},
    "publish_eligible": {"type": "boolean"},
    "production_eligible": {"type": "boolean"},
    "strategy_publication": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["market", "strategy", "eligible", "state"],
        "properties": {
          "market": {"type": "string", "minLength": 1},
          "strategy": {"type": "string", "minLength": 1},
          "eligible": {"type": "boolean"},
          "state": {"type": "string"},
          "historical_fallback": {"type": "boolean"},
          "last_successful_generated_at": {"type": ["string", "null"]},
          "blocking_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "backtest_release_status": {"enum": ["ready", "blocked", "unavailable"]},
    "backtest_release_contract": {
      "type": "object",
      "required": ["publication_state", "publish_eligible"],
      "properties": {
        "backtest_release": {"type": "string", "minLength": 8},
        "market": {"type": "string", "minLength": 1},
        "publication_state": {"enum": ["ready", "blocked", "unavailable"]},
        "publish_eligible": {"type": "boolean"},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}},
        "strategy_registry": {"type": "array", "items": {"type": "object"}},
        "performance_summary": {"type": "object"},
        "survivorship_audit": {"type": "object"},
        "research_only": {"type": "boolean"}
      },
      "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"publication_state": {"const": "ready"}}},
        "then": {"properties": {"strategy_registry": {"type": "array", "items": {"$ref": "#/$defs/strategy_release"}}}}
      }]
    },
    "blocking_reason": {"type": ["string", "null"]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "health": {"type": "object"}
  },
  "$defs": {
    "strategy_release": {
      "type": "object",
      "required": ["strategy_id", "strategy_version", "parameter_hash", "universe_version", "data_version", "code_commit", "backtest_release"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "strategy_version": {"type": "string", "minLength": 1},
        "parameter_hash": {"type": "string", "minLength": 8},
        "universe_version": {"type": "string", "minLength": 1},
        "data_version": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "minLength": 7},
        "backtest_release": {"type": "string", "minLength": 8}
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "properties": {
        "explainability": {"$ref": "#/$defs/explainability"}
      },
      "additionalProperties": true
    },
    "explainability": {
      "type": "object",
      "required": ["passed_conditions", "failed_conditions", "data_completeness", "risk_factors", "evidence", "signal_date", "invalidation"],
      "properties": {
        "passed_conditions": {"type": "array", "items": {"type": "string"}},
        "failed_conditions": {"type": "array", "items": {"type": "string"}},
        "data_completeness": {},
        "risk_factors": {"type": "array", "items": {"type": "string"}},
        "liquidity": {},
        "recent_events": {"type": "array", "items": {}},
        "valuation_position": {},
        "momentum_position": {},
        "quality_position": {},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "signal_date": {"type": ["string", "null"]},
        "invalidation": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "scan_state": {"enum": ["complete", "building", "failed"]},
        "candidate_state": {"enum": ["available", "available_from_completed_records", "no_candidates", "building", "data_gap", "data_unavailable", "failed", "historical"]},
        "candidates": {"type": ["integer", "null"], "minimum": 0},
        "visible_candidates": {"type": ["integer", "null"], "minimum": 0},
        "formal_candidates": {"type": ["integer", "null"], "minimum": 0},
        "observation_candidates": {"type": ["integer", "null"], "minimum": 0},
        "requested_records": {"type": ["integer", "null"], "minimum": 0},
        "complete_records": {"type": ["integer", "null"], "minimum": 0},
        "failed_records": {"type": ["integer", "null"], "minimum": 0},
        "data_gap_counts": {
          "anyOf": [
            {"type": ["integer", "null"], "minimum": 0},
            {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          ]
        },
        "visible_candidate_count": {"type": ["integer", "null"], "minimum": 0},
        "formal_candidate_count": {"type": ["integer", "null"], "minimum": 0},
        "observation_candidate_count": {"type": ["integer", "null"], "minimum": 0},
        "history_pending_count": {"type": ["integer", "null"], "minimum": 0},
        "source_failure_count": {"type": ["integer", "null"], "minimum": 0},
        "incomplete_record_count": {"type": ["integer", "null"], "minimum": 0},
        "candidates_definition": {"const": "visible_candidates"}
        ,"strategy_version_state": {"enum": ["current", "historical", "unavailable"]}
        ,"historical_fallback": {"type": "boolean"}
        ,"last_successful_generated_at": {"type": ["string", "null"]}
        ,"scan_attempted_at": {"type": ["string", "null"]}
        ,"scan_trading_date": {"type": ["string", "null"]}
        ,"quote_cutoff_at": {"type": ["string", "null"]}
        ,"last_successful_at": {"type": ["string", "null"]}
        ,"execution_version": {"type": ["string", "null"]}
        ,"data_hash": {"type": ["string", "null"]}
        ,"unscanned_in_run": {"type": "boolean"}
        ,"freshness_state": {"enum": ["最近收盤資料", "待更新", "更新失敗", "建檔中", "歷史資料", "資料日期不明"]}
      },
      "allOf": [
        {
          "if": {"required": ["candidate_state", "visible_candidates"], "properties": {"candidate_state": {"const": "no_candidates"}}},
          "then": {"properties": {"visible_candidates": {"const": 0}}}
        },
        {
          "if": {"required": ["candidate_state", "visible_candidates"], "properties": {"candidate_state": {"enum": ["available", "available_from_completed_records"]}}},
          "then": {"properties": {"visible_candidates": {"type": "integer", "minimum": 1}}}
        },
        {
          "if": {"required": ["scan_state", "candidate_state"], "properties": {"scan_state": {"const": "complete"}}},
          "then": {"properties": {"candidate_state": {"enum": ["available", "no_candidates"]}}}
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
