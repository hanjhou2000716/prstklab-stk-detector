{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk.example/schemas/market.schema.json",
  "type": "object",
  "required": ["generated_at", "snapshot_id", "indices", "quotes", "source_health"],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "snapshot_id": {"type": "string", "minLength": 8},
    "overall_state": {"enum": ["live", "mixed", "close_only", "degraded", "unavailable"]},
    "live_count": {"type": "integer", "minimum": 0},
    "recent_close_count": {"type": "integer", "minimum": 0},
    "stale_count": {"type": "integer", "minimum": 0},
    "unavailable_count": {"type": "integer", "minimum": 0},
    "release_id": {"type": "string", "minLength": 8},
    "policy_version": {"type": "string", "minLength": 1},
    "raw_observation": {
      "type": "object",
      "required": ["enabled", "recorded"],
      "properties": {
        "enabled": {"type": "boolean"},
        "recorded": {"type": "boolean"},
        "required": {"type": "boolean"},
        "state": {"enum": ["recorded", "disabled", "unavailable"]},
        "observation_id": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "instrument_master": {
      "type": "object",
      "required": ["schema_version", "registry_id", "instruments"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "registry_id": {"type": "string", "pattern": "^instrument-[a-f0-9]{16}$"},
        "instruments": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "source_catalog": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceCatalogItem"}
    },
    "indices": {"type": "array", "items": {"$ref": "#/$defs/quote"}},
    "quotes": {"type": "array", "items": {"$ref": "#/$defs/quote"}},
    "source_health": {"type": "object"}
  },
  "$defs": {
    "quote": {
      "type": "object",
      "required": ["ticker", "price", "quote_date", "source_label", "freshness"],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "price": {"type": ["number", "null"]},
        "quote_date": {"type": ["string", "null"]},
        "source_label": {"type": "string", "minLength": 1},
        "quote_source": {"type": "string"},
        "source_url": {"type": "string"},
        "source_domain": {"type": "string"},
        "quote_time": {"type": ["string", "null"]},
        "fetched_at": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"]},
        "freshness": {"type": "string"},
        "stale_used": {"type": "boolean"},
        "quote_delayed": {"type": "boolean"},
        "crosscheck_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "source_url": {"type": "string"},
              "quote_date": {"type": ["string", "null"]},
              "status": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "crosscheck_policy": {
          "type": "object",
          "required": ["ticker", "primary", "secondary", "max_gap_minutes", "max_gap_percent", "official_required"],
          "properties": {
            "ticker": {"type": "string", "minLength": 1},
            "primary": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "secondary": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "max_gap_minutes": {"type": "integer", "minimum": 0},
            "max_gap_percent": {"type": "number", "minimum": 0},
            "official_required": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "comparison_basis": {"enum": ["direction_only", "price_and_time", "not_defined"]},
        "technical_context": {
          "type": "object",
          "properties": {
            "as_of": {"type": ["string", "null"]},
            "technical_context_stale": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "sourceCatalogItem": {
      "type": "object",
      "required": ["provider", "endpoint", "source_tier", "adapter_contract_version", "provenance_fields", "health_fields", "alert_policy"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "format": "uri"},
        "source_tier": {"enum": ["official", "public-market", "discovery"]},
        "adapter_contract_version": {"type": "integer", "minimum": 1},
        "provenance_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "health_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "alert_policy": {"enum": ["crosscheck_required", "display_only"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
