{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "strategyRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "strategy_version", "parameter_hash", "universe_version", "data_version", "code_commit", "backtest_release"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "strategy_version": {"type": "string", "minLength": 1},
        "parameter_hash": {"type": "string", "minLength": 1},
        "universe_version": {"type": "string", "minLength": 1},
        "data_version": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "minLength": 1},
        "backtest_release": {"type": "string", "minLength": 1},
        "deployment_date": {"type": ["string", "null"]},
        "retirement_date": {"type": ["string", "null"]}
      }
    }
  },
  "type": "object",
  "required": ["backtest_release", "market", "publication_state", "publish_eligible", "blocking_reasons", "strategy_registry", "research_only"],
  "properties": {
    "backtest_release": {"type": "string", "pattern": "^backtest-[a-f0-9]{16}$"},
    "market": {"enum": ["taiwan", "us"]},
    "publication_state": {"enum": ["ready", "blocked"]},
    "publish_eligible": {"type": "boolean"},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "strategy_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strategyRegistry"
      }
    },
    "strategy_registry_validation": {
      "type": "object",
      "required": ["status", "errors"],
      "properties": {
        "status": {"enum": ["pass", "failed"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "performance_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "integer", "null"]
          }
        }
      }
    },
    "survivorship_audit": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": ["string", "null"]},
        "snapshot_dates": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "research_only": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"publication_state": {"const": "ready"}}},
      "then": {"properties": {"publish_eligible": {"const": true}, "blocking_reasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"publication_state": {"const": "blocked"}}},
      "then": {"properties": {"publish_eligible": {"const": false}, "blocking_reasons": {"minItems": 1}}}
    }
  ]
}
