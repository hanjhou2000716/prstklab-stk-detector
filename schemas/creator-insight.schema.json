{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk.example/schemas/creator-insight.schema.json",
  "type": "object",
  "required": ["episode_key", "content_origin", "claims", "opinions", "verification_state", "public_safe"],
  "properties": {
    "creator_id": {"type": "string"},
    "creator_name": {"type": "string"},
    "episode_key": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string"},
    "episode_title": {"type": "string"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "source_message_id": {"type": "string"},
    "source_url": {"type": "string"},
    "content_origin": {"enum": ["haojiao", "gooaye", "unknown"]},
    "topics": {"type": "array", "items": {"type": "string"}},
    "markets": {"type": "array", "items": {"type": "string"}},
    "sectors": {"type": "array", "items": {"type": "string"}},
    "tickers": {"type": "array", "items": {"type": "string"}},
    "key_takeaways": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "items": {"type": "string"}},
    "opinions": {"type": "array", "items": {"type": "string"}},
    "consensus_stance": {"enum": ["", "risk_on", "risk_off", "neutral"]},
    "verification_state": {"enum": ["verified", "partially_verified", "unverified", "contradicted", "not_applicable"]},
    "evidence_alignment": {"enum": ["aligned", "partially_aligned", "not_verifiable", "market_divergent"]},
    "summary_image_available": {"type": "boolean"},
    "summary_image_hash": {"type": "string"},
    "parse_status": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "public_safe": {"const": true}
  },
  "additionalProperties": true
}
